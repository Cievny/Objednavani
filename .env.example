# Supabase projekt (Settings -> API). Bez tychto hodnot bezi appka
# v demo rezime na localStorage prehliadaca.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Audit vlna 8
# Pripnutý IBAN (produkcia ho má v deploy.yml). Bez neho sa v Supabase režime
# pacientovi QR kód ani IBAN nezobrazí (platobné údaje dostane e-mailom).
VITE_PINNED_IBAN=
# Demo prístupový kód do správy v režime bez Supabase (lokálny vývoj).
# V produkčnom builde nie je — tam je prihlásenie cez Supabase Auth + MFA.
VITE_DEMO_CODE=
